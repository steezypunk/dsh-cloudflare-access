{
  "name": "dsh-cloudflare-access",
  "version": "2.0.0",
  "description": "Cloudflare Access JWT verification and remote DSH privileged authorization",
  "type": "module",
  "license": "MIT",
  "author": "Luawig",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cloudflare",
    "cloudflare-access",
    "jwt",
    "cordis"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luawig/dsh-cloudflare-access.git"
  },
  "bugs": {
    "url": "https://github.com/Luawig/dsh-cloudflare-access/issues"
  },
  "homepage": "https://github.com/Luawig/dsh-cloudflare-access#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-client.mjs",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "pnpm test && pnpm typecheck && node scripts/check-pack.mjs",
    "pack:check": "node scripts/check-pack.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "immediately": true
    }
  }
}
